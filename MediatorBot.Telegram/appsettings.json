{
  "ModelRuntime": "Fake",
  "Storage": {
    "DatabasePath": "data/mediator-bot-telegram.db",
    "MaxHistoryMessages": 200
  },
  "OpenAI": {
    "Endpoint": "https://api.openai.com/v1",
    "Model": "gpt-4.1-mini",
    "MaxOutputTokens": 1500,
    "MaxAttempts": 3,
    "RequestTimeoutSeconds": 120,
    "RetryBaseDelayMilliseconds": 1000,
    "RetryMaxDelaySeconds": 30
  },
  "TurnProcessing": {
    "MaxAttempts": 3,
    "RetryDelaySeconds": 15
  },
  "Compaction": {
    "Enabled": true,
    "TriggerMessageCount": 200,
    "TriggerHistoryCharacters": 50000,
    "RetainRecentMessageCount": 80,
    "RetainRecentCharacters": 20000,
    "MaxSummaryCharacters": 6000,
    "MaxOutputTokens": 2000,
    "OperationTimeoutSeconds": 180,
    "RetryDelaySeconds": 60
  },
  "Telegram": {
    "SessionId": "",
    "ParticipantAUserId": 0,
    "ParticipantADisplayName": "A",
    "ParticipantBUserId": 0,
    "ParticipantBDisplayName": "B",
    "DeliveryTimeoutSeconds": 30,
    "DeliveryRecordingTimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  }
}
