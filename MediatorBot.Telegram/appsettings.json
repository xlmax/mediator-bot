{
  "ModelRuntime": "Fake",
  "Storage": {
    "DatabasePath": "data/mediator-bot-telegram.db",
    "MaxHistoryMessages": 100
  },
  "OpenAI": {
    "Endpoint": "https://api.openai.com/v1",
    "Model": "gpt-4.1-mini",
    "MaxOutputTokens": 1500
  },
  "Telegram": {
    "SessionId": "",
    "ParticipantAUserId": 0,
    "ParticipantBUserId": 0,
    "DeliveryTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  }
}
