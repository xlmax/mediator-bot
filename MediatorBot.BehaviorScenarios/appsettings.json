{
  "OpenAI": {
    "ApiKey": "",
    "Endpoint": "https://api.openai.com/v1",
    "Model": "gpt-4.1-mini",
    "MaxOutputTokens": 1500,
    "MaxAttempts": 3,
    "RequestTimeoutSeconds": 120,
    "RetryBaseDelayMilliseconds": 1000,
    "RetryMaxDelaySeconds": 30
  },
  "Behavior": {
    "Mode": "Disclosure",
    "TranscriptDirectory": "artifacts/behavioral"
  },
  "Initiative": {
    "MinimumReevaluationMinutes": 30,
    "MaximumReevaluationMinutes": 10080
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
